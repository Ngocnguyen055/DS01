# Đổi hai secret thành chuỗi ngẫu nhiên tối thiểu 32 ký tự khi chạy production.
JWT_SECRET=replace-with-a-long-random-jwt-secret
PEER_SECRET=replace-with-a-different-long-random-peer-secret

SIGNAL_PORT=4001
RELAY_PORT=4002

# Relay gọi signaling qua địa chỉ nội bộ để kiểm tra quyền nhóm.
SIGNAL_INTERNAL_URL=http://127.0.0.1:4001

# Chỉ cần API nếu mở rộng sang Peer ID tài khoản Mongo 24 ký tự hex
# hoặc nhóm dự án. Demo peer-a/peer-b/peer-c không cần API.
API_INTERNAL_URL=http://127.0.0.1:4000

# URL trình duyệt dùng để nối signaling và relay.
VITE_SIGNAL_URL=http://localhost:4001
VITE_RELAY_URL=http://localhost:4002
# Optional backup relays: comma separated; each peer connects to the same pool.
VITE_RELAY_URLS=
# Optional ICE configuration (JSON). TURN credentials are visible to the browser.
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# CLI signaling defaults to .data/signaling.json; set a different absolute path if needed.
# SIGNAL_STATE_PATH=F:/Downloads/DS01/.data/signaling.json

# URL được script benchmark sử dụng.
PUBLIC_SIGNAL_URL=http://localhost:4001
PUBLIC_RELAY_URL=http://localhost:4002

# Optional local account registry; default: SIGNAL_STATE_PATH + .accounts.json
# ACCOUNT_STATE_PATH=F:/Downloads/DS01/.data/accounts.json
