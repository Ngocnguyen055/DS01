{
  "name": "ds01-p2p-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "src/shared",
    "src/signaling",
    "src/relay",
    "src/web-peer"
  ],
  "scripts": {
    "dev:signaling": "npm run dev -w @ds01/signaling",
    "dev:relay": "npm run dev -w @ds01/relay",
    "dev:web": "npm run dev -w @ds01/web-peer",
    "start:signaling": "npm run start -w @ds01/signaling",
    "start:relay": "npm run start -w @ds01/relay",
    "build:web": "npm run build -w @ds01/web-peer",
    "typecheck": "tsc --noEmit -p src/shared && tsc --noEmit -p src/signaling && tsc --noEmit -p src/relay && tsc --noEmit -p src/web-peer && tsc --noEmit -p scripts",
    "lint": "eslint src tests scripts --ext .ts,.tsx",
    "test": "vitest run",
    "test:core": "vitest run tests/protocol.test.ts tests/services.test.ts tests/peer.test.ts tests/project-chat.test.ts",
    "benchmark:relay": "tsx scripts/benchmark-relay.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
