# Secret chỉ dùng phía server. Tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự.
JWT_SECRET=replace-with-a-long-random-jwt-secret
PEER_SECRET=replace-with-a-different-long-random-peer-secret

SIGNAL_PORT=4001
RELAY_PORT=4002
SIGNAL_INTERNAL_URL=http://127.0.0.1:4001

VITE_SIGNAL_URL=https://signal.example.org
VITE_RELAY_URL=https://relay.example.org
VITE_RELAY_URLS=https://relay-backup.example.org
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
PUBLIC_SIGNAL_URL=https://signal.example.org
PUBLIC_RELAY_URL=https://relay.example.org

# Chỉ cần khi tích hợp tài khoản Mongo/nhóm dự án từ hệ thống Mobile.
API_INTERNAL_URL=http://127.0.0.1:4000
